<?xml version="1.0" encoding="utf-8"?>

<!-- timetable_module/security/timetable_security.xml -->

<odoo>
    <record id="module_timetable_category" model="ir.module.category">
        <field name="name">Timetable</field>
        <field name="description">Timetable Management</field>
        <field name="sequence">1</field>
    </record>

    <record id="group_timetable_user" model="res.groups">
        <field name="name">User</field>
        <field name="category_id" ref="module_timetable_category"/>
        <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
    </record>

    <record id="group_timetable_manager" model="res.groups">
        <field name="name">Manager</field>
        <field name="category_id" ref="module_timetable_category"/>
        <field name="implied_ids" eval="[(4, ref('group_timetable_user'))]"/>
        <field name="users" eval="[(4, ref('base.user_root')), (4, ref('base.user_admin'))]"/>
    </record>
</odoo>
