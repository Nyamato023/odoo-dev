<?xml version="1.0" encoding="utf-8"?>
<!-- timetable_module/views/timetable_config_views.xml -->
<odoo>
    <!-- View for Config Settings -->
    <record id="timetable_config_settings_view_form" model="ir.ui.view">
        <field name="name">timetable.config.settings.form</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="base.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//div[hasclass('settings')]" position="inside">
                <div class="app_settings_block" data-string="Timetable" string="Timetable" data-key="timetable">
                    <h2>Timetable Settings</h2>
                    <div class="row mt16 o_settings_container">
                        <div class="col-12 col-lg-6 o_setting_box">
                            <div class="o_setting_left_pane">
                                <field name="link_projects"/>
                            </div>
                            <div class="o_setting_right_pane">
                                <label for="link_projects"/>
                                <div class="text-muted">
                                    Enable linking with Projects module.
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </xpath>
        </field>
    </record>
</odoo>
