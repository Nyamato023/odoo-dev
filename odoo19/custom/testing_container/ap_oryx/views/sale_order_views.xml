<odoo>
    <record id="view_order_form_inherit_weight_volume" model="ir.ui.view">
        <field name="name">sale.order.form.weight.volume</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_order_form"/>
        <field name="arch" type="xml">

            <xpath expr="//field[@name='order_line']/list/field[@name='product_uom_qty']" position="after">
                <field name="total_weight" optional="hide"/>
                <field name="total_volume" optional="hide"/>
            </xpath>

        </field>
    </record>
</odoo>