<odoo>
    <record id="view_move_form_inherit_weight_volume" model="ir.ui.view">
        <field name="name">account.move.form.weight.volume</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_move_form" />
        <field name="arch" type="xml">

            <xpath expr="//field[@name='invoice_line_ids']/list/field[@name='quantity']"
                position="after">
                <field name="total_weight" optional="hide" />
                <field name="total_volume" optional="hide" />
            </xpath>

        </field>
    </record>


</odoo>