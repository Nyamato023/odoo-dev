<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <template id="portal_my_details_member"
        inherit_id="portal.portal_my_details">

        <xpath expr="//t[@t-call='portal.address_form_fields']"
            position="after">

            <t t-set="entity_type" t-value="current_partner.entity_type" />

            <!-- ================================================= -->
            <!-- Entity Type -->
            <!-- ================================================= -->

            <div class="col-12 mb-4">

                <label class="form-label">
                    Entity Type
                </label>

                <select name="entity_type"
                    class="form-select">

                    <option value="member"
                        t-att-selected="'selected' if entity_type == 'member' else None">
                        Member
                    </option>

                    <option value="stakeholder"
                        t-att-selected="'selected' if entity_type == 'stakeholder' else None">
                        Stakeholder
                    </option>

                    <option value="service_provider"
                        t-att-selected="'selected' if entity_type == 'service_provider' else None">
                        Service Provider
                    </option>

                    <option value="branch"
                        t-att-selected="'selected' if entity_type == 'branch' else None">
                        Branch
                    </option>

                    <option value="affiliation"
                        t-att-selected="'selected' if entity_type == 'affiliation' else None">
                        Affiliation
                    </option>

                    <option value="contact"
                        t-att-selected="'selected' if entity_type == 'contact' else None">
                        Contact
                    </option>

                </select>

            </div>

            <!-- member -->

            <t t-if="current_partner.entity_type == 'member'">

                <div class="card mb-4">
                    <div class="card-header">
                        <strong>General Information</strong>
                    </div>

                    <div class="card-body row">

                        <div class="col-md-6">
                            <label>Registered Name</label>
                            <input class="form-control" name="registered_name"
                                t-att-value="current_partner.registered_name or ''" />

                            <label class="mt-2">Trading Name</label>
                            <input class="form-control" name="trading_name"
                                t-att-value="current_partner.trading_name or ''" />

                            <label class="mt-2">Affiliation Name</label>
                            <input class="form-control" name="affiliation_name"
                                t-att-value="current_partner.affiliation_name or ''" />
                        </div>

                        <div class="col-md-6">

                            <label>CIPC Number</label>
                            <input class="form-control" name="cipc_number"
                                t-att-value="current_partner.cipc_number or ''" />

                            <label class="mt-2">NCR Number</label>
                            <input class="form-control" name="ncr_number"
                                t-att-value="current_partner.ncr_number or ''" />

                            <label class="mt-2">CASA Number</label>
                            <input class="form-control" name="casa_number"
                                t-att-value="current_partner.casa_number or ''" />

                            <label class="mt-2">MFSA Number</label>
                            <input class="form-control" name="mfsa_number"
                                t-att-value="current_partner.mfsa_number or ''" />

                            <label class="mt-2">Pastel Number</label>
                            <input class="form-control" name="pastel_number"
                                t-att-value="current_partner.pastel_number or ''" />

                            <label class="mt-2">Branches</label>
                            <input class="form-control" name="branches"
                                t-att-value="current_partner.branches or ''" />

                        </div>

                    </div>
                </div>

                <div class="card">

                    <div class="card-header">
                        <strong>Status</strong>
                    </div>

                    <div class="card-body row">

                        <div class="col-md-3">
                            <label>Member Status</label>
                            <input class="form-control"
                                name="member_status"
                                t-att-value="current_partner.member_status or ''" />
