<?xml version="1.0" encoding="UTF-8"?>
<odoo>

    <!-- Add the new field to the form (hidden) -->
    <record id="view_move_form_add_vendor_bill_field" model="ir.ui.view">
        <field name="name">account.move.form.add.vendor.bill.field</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_move_form"/>
        <field name="arch" type="xml">
            <xpath expr="//sheet" position="inside">
                <field name="vendor_bill_id" invisible="1"/>
            </xpath>
        </field>
    </record>

    <!-- Add Create Vendor Bill button -->
    <record id="view_move_form_create_bill_button" model="ir.ui.view">
        <field name="name">account.move.form.create.bill.button</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_move_form"/>
        <field name="arch" type="xml">
            <xpath expr="//header" position="inside">
                <button name="action_create_vendor_bill"
                        type="object"
                        string="Create Vendor Bill"
                        class="btn-primary"
                        invisible="move_type != 'out_invoice' or vendor_bill_id"/>
            </xpath>
        </field>
    </record>

    <!-- Smart button for created vendor bill -->
    <record id="view_move_form_vendor_bill_smart_button" model="ir.ui.view">
        <field name="name">account.move.form.vendor.bill.smartbutton</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_move_form"/>
        <field name="arch" type="xml">
            <xpath expr="//sheet//div[@name='button_box']" position="inside">
                <button name="action_open_vendor_bill"
                        type="object"
                        class="oe_stat_button"
                        icon="fa-file-text-o"
                        string="Vendor Bill"
                        invisible="not vendor_bill_id">
                    <field name="vendor_bill_id" widget="statinfo"/>
                </button>
            </xpath>
        </field>
    </record>


    <record id="view_move_form_inherit_hospital" model="ir.ui.view">
        <field name="name">account.move.form.hospital</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_move_form"/>
        <field name="arch" type="xml">

            <xpath expr="//field[@name='invoice_date']" position="after">
                <field name="hospital_id"
                       invisible="move_type == 'in_invoice'"
                />
            </xpath>

        </field>
    </record>

    <record id="view_partner_form_inherit_hospital" model="ir.ui.view">
    <field name="name">res.partner.form.inherit.hospital</field>
    <field name="model">res.partner</field>
    <field name="inherit_id" ref="base.view_partner_form"/>
    <field name="arch" type="xml">
        <xpath expr="//field[@name='category_id']" position="after">
            <field name="is_hospital"/>
        </xpath>
    </field>
</record>

</odoo>