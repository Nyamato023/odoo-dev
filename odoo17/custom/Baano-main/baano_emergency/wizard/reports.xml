<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_baano_report_wizard_form" model="ir.ui.view">
        <field name="name">baano.report.wizard.form</field>
        <field name="model">baano.report.wizard</field>
        <field name="arch" type="xml">
            <form string="Print Report">
                <div class="oe_title">
                    <!-- <label for="report_type" class="oe_edit_only" string="Patient Name" /> -->
                    <h1>
                        <field name="report_type" readonly="1" />
                    </h1>
                </div>
                <group>
                    <field name="from_date" />
                    <field name="to_date" />
                </group>
                <footer>
                    <button name="action_print_report" string="Print" type="object" class="btn-primary" />
                    <button string="Cancel" class="btn-secondary" special="cancel" />
                </footer>
            </form>
        </field>
    </record>

    <record id="action_baano_report_wizard" model="ir.actions.act_window">
        <field name="name">Print Report</field>
        <field name="res_model">baano.report.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>

    <!-- <report id="disease_types_report" model="baano.report.wizard" string="Disease Types Report" report_type="qweb-pdf" name="baano_emergency.disease_types_report" print_report_name="'Disease Types Report'" /> -->

</odoo>