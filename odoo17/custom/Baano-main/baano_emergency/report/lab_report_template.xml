<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <template id="lab_report">
        <t t-name="baano_emergency.lab_report">
            <t t-call="web.external_layout">
                <main class="page">

                    <h2
                        style="text-align: center; font-size: 20px; margin-bottom: 20px; color: red;">
                        Laboratory Test Report
                    </h2>

                    <!-- Loop over all docs passed to the report -->
                    <t t-foreach="docs" t-as="doc">

                        <div class="row">
                            <div class="col-12">
                                <div class="card mb-4">
                                    <div class="card-body bg-light">
                                        <h3 class="card-title mb-3 text-center">Summary for Current
                                            Appointment</h3>

                                        <div class="row mb-2">
                                            <div class="col-4">
                                                <p>
                                                    <strong>Patient:</strong>
                                                    <span t-field="doc.patient_id" />
                                                </p>
                                                <p class="ms-3 mb-1">
                                                    <strong>Gender:</strong>
                                                    <span t-field="doc.patient_id.gender" />
                                                </p>
                                                <p class="ms-3">
                                                    <strong>Age:</strong>
                                                    <span t-field="doc.patient_id.age" />
                                                </p>
                                            </div>
                                            <!-- company info -->
                                            <!-- <div class="col-4">
                                                <p>
                                                    <strong>Company:</strong>
                                                    <t t-if="doc.patient_id.company">
                                                        <span t-field="doc.patient_id.company" />
                                                    </t>
                                                    <t t-else="">N/A</t>
                                                </p>
                                            </div> -->
                                            <div class="col-4">
                                                <p>
                                                    <strong>Doctor:</strong>
                                                    <t t-if="doc.doctor_id">
                                                        <span t-field="doc.doctor_id" />
                                                    </t>
                                                    <t t-else="">N/A</t>
                                                </p>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <h4 style="margin-top: 20px; font-size: 16px;">Test Results:</h4>
                        <table class="table table-sm"
                            style="width: 100%; border-collapse: collapse;" border="1">
                            <thead style="background-color: #f0f0f0;">
                                <tr>
                                    <th style="padding: 6px;">Test</th>
                                    <th style="padding: 6px;">Patient</th>
                                    <th style="padding: 6px;">Doctor</th>
                                    <th style="padding: 6px;">Date</th>
                                </tr>
                            </thead>
                            <tbody>
                                <!-- Loop over the lines of the current doc -->
                                <t t-foreach="doc.lab_request_id" t-as="line">
                                    <tr>
                                        <td style="padding: 6px;">
                                            <t t-esc="line.test_ids.name" />
                                        </td>
                                        <td style="padding: 6px;">
                                            <t t-esc="doc.patient_id.name" />
                                        </td>
                                        <td style="padding: 6px;">
                                            <t t-esc="line.doctor_id.name" />
                                        </td>
                                        <td style="padding: 6px;">
                                            <t t-esc="line.date" />
                                        </td>
                                    </tr>
                                </t>
                            </tbody>
                        </table>

                        <div style="page-break-after: always;"></div>
                    </t>

                </main>
            </t>
        </t>
    </template>
</odoo>
