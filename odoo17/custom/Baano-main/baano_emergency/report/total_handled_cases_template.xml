<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <data>
        <!-- Report Template for Handled Cases -->
        <template id="handled_cases_report">
            <t t-name="baano_emergency.handled_cases_report">
                <t t-call="web.external_layout">
                    <main class="page">
                        <div class="oe_structure">
                            <h1 class="text-center text-danger mb-4">Total Handled Cases</h1>

                            <!-- Summary Section -->
                            <div class="row">
                                <div class="col-12">
                                    <!-- Use 'docs' instead of searching all records -->
                                    <t t-set="all_cases" t-value="docs" />

                                    <div class="card mb-4">
                                        <div class="card-body bg-light">
                                            <h3 class="card-title mb-3 text-center">Summary</h3>

                                            <div class="row mb-2">
                                                <!-- Total Cases + Male/Female -->
                                                <div class="col-4">
                                                    <p>
                                                        <strong>Total Cases:</strong>
                                                        <span t-esc="len(all_cases)" />
                                                    </p>
                                                    <p class="ms-3 mb-1"> Male: <span
                                                            t-esc="len([c for c in all_cases if c.patient_id.gender == 'male'])" />
                                                    </p>
                                                    <p class="ms-3"> Female: <span
                                                            t-esc="len([c for c in all_cases if c.patient_id.gender == 'female'])" />
                                                    </p>
                                                </div>

                                                <!-- Company -->
                                                <!-- <div class="col-4">
                                                    <p>
                                                        <strong>Company:</strong>
                                                        <t
                                                            t-if="all_cases and all_cases[0].patient_id.company">
                                                            <span
                                                                t-field="all_cases[0].patient_id.company" />
                                                        </t>
                                                        <t t-else="">N/A</t>
                                                    </p>
                                                </div> -->

                                                <!-- Doctor -->
                                                <div class="col-4">
                                                    <p>
                                                        <strong>Doctor:</strong>
                                                        <t
                                                            t-if="all_cases and all_cases[0].doctor_id">
                                                            <span t-field="all_cases[0].doctor_id" />
                                                        </t>
                                                        <t t-else="">N/A</t>
                                                    </p>
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>

                            <!-- Cases Table -->
                            <div class="row mt-4">
                                <div class="col-12">
                                    <h3 class="text-center">Cases List</h3>
                                    <table class="table table-bordered">
                                        <thead>
                                            <tr>
                                                <th>Appointment Date</th>
                                                <th>Company ID</th>
                                                <th>Patient Name</th>
                                                <th>Gender</th>
                                                <th>Doctor</th>
                                                <th>SiteID</th>
                                            </tr>
                                        </thead>
                                        <tbody>
                                            <!-- Use already set all_cases -->
                                            <t t-foreach="all_cases" t-as="case">
                                                <tr>
                                                    <td>
                                                        <span t-field="case.appointment_date" />
                                                    </td>
                                                    <td>
                                                        <span
                                                            t-field="case.patient_id.company_id_number" />
                                                    </td>
                                                    <td>
                                                        <span t-field="case.patient_id.name" />
                                                    </td>
                                                    <td>
                                                        <span t-field="case.patient_id.gender"
                                                            t-options="{'widget': 'selection'}" />
                                                    </td>
                                                    <!-- <td>
                                                        <t t-if="case.patient_id.company">
                                                            <span t-field="case.patient_id.company" />
                                                        </t>
                                                        <t t-else="">N/A</t>
                                                    </td> -->

                                                     <td>
                                                        <t t-if="case.doctor_id">
                                                            <span t-field="case.doctor_id"/>
                                                        </t>
                                                        <t t-else="">N/A</t>
                                                    </td>

                                                    <td>
                                                        <t t-if="case.patient_id.site_id">
                                                            <span t-field="case.patient_id.site_id"/>
                                                        </t>
                                                        <t t-else="">N/A</t>
                                                    </td>
                                                </tr>
                                            </t>
                                        </tbody>
                                    </table>
                                </div>
                            </div>

                        </div>
                    </main>
                </t>
            </t>
        </template>
    </data>
</odoo>
