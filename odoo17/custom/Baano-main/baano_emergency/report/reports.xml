<odoo>
    <!-- Disease Types Report -->
    <record id="action_disease_types_report" model="ir.actions.report">
        <field name="name">Disease Types Report</field>
        <field name="model">baano.appointment</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">baano_emergency.disease_types_report</field>
        <field name="binding_model_id" eval="ref('baano_emergency.model_baano_appointment')" />
        <field name="print_report_name">'Disease Report - %s' % (object.name or 'Summary')</field>
    </record>

