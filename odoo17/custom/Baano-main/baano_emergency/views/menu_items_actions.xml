    <!--   CONFIGURATION MENU   -->
    <!-- ===================== -->
    
    <!-- Parent Configuration Menu -->
    <menuitem
        id="menu_baano_configuration"
        name="Configuration"
        parent="menu_baano_root"
        sequence="50"
        groups="group_baano_user"
    />
    
    <!-- ======== Sites ======== -->
    
    <!-- Action for Sites -->
    <record id="action_baano_sites" model="ir.actions.act_window">
        <field name="name">Sites</field>
        <field name="res_model">baano.site</field>
        <field name="view_mode">tree,form</field>
    </record>
    
    <!-- Menuitem for Sites -->
    <menuitem
        id="menu_baano_sites"
        name="Sites"
        parent="menu_baano_configuration"
        action="action_baano_sites"
        sequence="1"
        groups="group_baano_user"
    />
    
