<odoo>
    <record id="sequence_prescription" model="ir.sequence">
        <field name="name">Prescription Sequence</field>
        <field name="code">baano.prescription</field>
        <field name="prefix">PR/</field>
        <field name="padding">5</field>
        <field name="company_id" eval="False" />
    </record>
    <record id="view_baano_prescription_form" model="ir.ui.view">
        <field name="name">baano.prescription.form</field>
        <field name="model">baano.prescription</field>
        <field name="arch" type="xml">
            <form string="Prescription">
                <sheet>
                    <div class="oe_title">
                        <label for="name" class="oe_edit_only" string="Prescription" />
                        <h1>
                            <field name="name" />
                        </h1>
                    </div>
                    <group>
                        <group>
                            <field name="patient_id"
                            />
                            <field name="prescribing_doctor"
                            />
                            <!-- <field name="medicaments_group" /> -->
                        </group>
                        <group>
                            <!-- <field name="disease_id" /> -->
                            <field name="prescription_date"
                            />
                            <!-- <field name="pregnancy_warning" /> -->
                        </group>
                    </group>
                    <notebook>
                        <page string="Prescription Lines">
                            <!-- <group>
                            <field name="kit" />
                            <field name="old_prescription" />
                        </group> -->


                            <field name="prescription_lines">
                                <tree editable="bottom">
                                    <field name="medicine_id" />
                                    <!-- <field name="product_type" /> -->
                                    <field name="name" />
                                    <field name="dosage_frequency" />
                                    <field name="qty_dose" />
                                    <field name="days" />
                                    <field name="total_qty" />
                                    <field name="comment" />
                                </tree>
                            </field>


                        </page>
                        <page string="General Information">
                            <group>
                                <field name="appointment_id" />
                                <field name="treatment" />
                                <!-- <field name="pickings" /> -->
                            </group>


                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>
    <record id="view_baano_prescription_tree" model="ir.ui.view">
        <field name="name">baano.prescription.tree</field>
        <field name="model">baano.prescription</field>
        <field name="arch" type="xml">
            <tree string="Prescriptions">
                <field name="patient_id" />
                <field name="prescribing_doctor" />
                <field name="prescription_date" />
                <field name="pregnancy_warning" optional="hide" />

            </tree>
        </field>
    </record>

</odoo>