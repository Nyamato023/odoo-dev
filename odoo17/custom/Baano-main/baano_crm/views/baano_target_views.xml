<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Filtered Action for Products of type Service -->
    <record id="action_baano_service_product" model="ir.actions.act_window">
        <field name="name">Services</field>
        <field name="res_model">product.template</field>
        <field name="view_mode">tree,kanban,form</field>
        <field name="domain">[('detailed_type', '=', 'service')]</field>
        <field name="context">{'default_detailed_type': 'service'}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Create your first Service!
            </p>
        </field>
    </record>

    <!-- Baano Target Views -->
    <record id="view_baano_target_tree" model="ir.ui.view">
        <field name="name">baano.target.tree</field>
        <field name="model">baano.target</field>
        <field name="arch" type="xml">
            <tree string="Targets" editable="bottom">
                <field name="sequence" widget="handle" optional="hide"/>
                <field name="service_type" width="150"/>
                <field name="date_start" width="120"/>
                <field name="date_stop" width="120"/>
                <field name="target_count" width="100"/>
            </tree>
        </field>
    </record>

    <record id="view_baano_target_form" model="ir.ui.view">
        <field name="name">baano.target.form</field>
        <field name="model">baano.target</field>
        <field name="arch" type="xml">
            <form string="Target">
                <sheet>
                    <group>
                        <group>
                            <field name="service_type"/>
                            <field name="target_count"/>
                            <field name="date"/>
                        </group>
                        <group>
                            <field name="date_start"/>
                            <field name="date_stop"/>
                            <field name="active" widget="boolean_toggle"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Target Lines" name="target_lines">
                            <field name="line_ids">
                                <tree editable="bottom">
                                    <field name="sequence" widget="handle" optional="hide"/>
                                    <field name="service_type"/>
                                    <field name="start_date"/>
                                    <field name="end_date"/>
                                    <field name="target_count"/>
                                </tree>
                            </field>
                        </page>
                    </notebook>
                </sheet>
                <div class="oe_chatter">
                    <field name="message_follower_ids"/>
                    <field name="activity_ids"/>
                    <field name="message_ids"/>
                </div>
            </form>
        </field>
    </record>

    <record id="view_baano_target_search" model="ir.ui.view">
        <field name="name">baano.target.search</field>
        <field name="model">baano.target</field>
        <field name="arch" type="xml">
            <search string="Search Targets">
                <field name="service_type"/>
                <filter string="Active" name="active" domain="[('active', '=', True)]"/>
                <separator/>
                <group expand="0" string="Group By">
                    <filter string="Services" name="group_by_service" context="{'group_by': 'service_type'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_baano_target" model="ir.actions.act_window">
        <field name="name">Targets</field>
        <field name="res_model">baano.target</field>
        <field name="view_mode">tree,form</field>
        <field name="search_view_id" ref="view_baano_target_search"/>
        <field name="context">{'search_default_group_by_service': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Create your first sales target!
            </p>
        </field>
    </record>
</odoo>
