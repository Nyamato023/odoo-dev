<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <template id="report_daily_checklist_template">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="o">
                <t t-call="web.external_layout">
                    <div class="page">
                        <style>
                            .checklist-table {
                                width: 100%;
                                border-collapse: collapse;
                                margin-top: 25px;
                                table-layout: fixed;
                            }
                            .checklist-table tr {
                                height: 120px; /* Default row height - grows with content */
                            }
                            .checklist-table thead tr {
                                height: 40px; /* Smaller height for the header row */
                            }
                            .checklist-table th, .checklist-table td {
                                border: 1px solid black;
                                padding: 5px 10px;
                                vertical-align: middle;
                                font-size: 16px;
                                word-wrap: break-word;
                            }
                            .checklist-table th {
                                background-color: #f2f2f2;
                                text-align: center;
                                font-weight: bold;
                                font-size: 16px;
                            }
                            .task-column { width: 33%; }
                            .notes-column { width: 57%; }
                            .check-column { width: 10%; text-align: center; font-size: 22px; }

                            /* Large default cell minimum height to mimic the lined paper look */
                            .notes-cell {
                                min-height: 130px;
                            }
                            .line-row {
                                border-bottom: 1px solid #bbb;
                                height: 26px;
                                display: block;
                                width: 100%;
                            }

                            .header-container {
                                padding-bottom: 15px;
                            }
                            .report-title {
                                text-transform: uppercase;
                                font-weight: bold;
                                font-size: 24px;
                                text-align: center;
                                margin: 0;
                            }
                            .ref-label {
                                font-size: 21px;
                                font-weight: bold;
                                text-align: right;
                                margin-bottom: 4px;
                            }
                            .date-label {
                                font-size: 19px;
                                text-align: right;
                            }

                            .hospital-grid {
                                width: 100%;
                            }
                            .hospital-item {
                                border-bottom: 1px solid #bbb;
                                min-height: 28px;
                                font-size: 15px;
                                padding: 2px 4px;
                                display: inline-block;
                                width: 48%;
                                vertical-align: top;
                                margin-bottom: 5px;
                                overflow: hidden;
                                text-overflow: ellipsis;
                                white-space: nowrap;
                            }
                        </style>

                        <!-- Header: Title left, Ref/Date stacked on right -->
                        <div class="header-container">
                            <div class="row">
                                <div class="col-7 d-flex align-items-center">
                                    <h2 class="report-title">DAILY COORDINATION CHECKLIST</h2>
                                </div>
                                <div class="col-5">
                                    <div class="ref-label">
                                        <span t-field="o.name"/>
                                    </div>
                                    <div class="date-label">
                                        Date: <span t-field="o.date"/>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <table class="checklist-table">
                            <thead>
                                <tr>
                                    <th class="check-column"><i class="fa fa-check"/></th>
                                    <th class="task-column">Task</th>
                                    <th class="notes-column">Notes</th>
                                </tr>
                            </thead>
                            <tbody>
                                <!-- 1. Contacted Hospitals -->
                                <tr>
                                    <td class="check-column">
                                        <t t-if="o.line_ids">
                                            <i class="fa fa-check-square-o"/>
                                        </t>
                                        <t t-else="">
                                            <i class="fa fa-square-o"/>
                                        </t>
                                    </td>
                                    <td><strong>Contact at least 10 hospitals</strong></td>
                                    <td class="notes-cell">
                                        <t t-if="o.line_ids">
                                            <div class="hospital-grid">
                                                <t t-foreach="o.line_ids" t-as="line">
                                                    <div class="hospital-item">
                                                        <span t-esc="line_index + 1"/>. <span t-field="line.hospital_id.x_name"/>
                                                    </div>
                                                </t>
                                            </div>
                                        </t>
                                        <t t-else="">
                                            <div class="hospital-grid">
                                                <t t-foreach="range(10)" t-as="i">
                                                    <div class="hospital-item">
                                                        <span t-esc="i + 1"/>. 
                                                    </div>
                                                </t>
                                            </div>
                                        </t>
                                    </td>
                                </tr>

                                <!-- 2. Update Doctor Profiles -->
                                <tr>
                                    <td class="check-column">
                                        <t t-if="o.doctor_notes">
                                            <i class="fa fa-check-square-o"/>
                                        </t>
                                        <t t-else="">
                                            <i class="fa fa-square-o"/>
                                        </t>
                                    </td>
                                    <td><strong>Update doctor profiles (leaves, resignations, new doctors)</strong></td>
                                    <td class="notes-cell">
                                        <t t-if="o.doctor_notes">
                                            <span t-field="o.doctor_notes"/>
                                        </t>
                                        <t t-else="">
                                            <span class="line-row"/>
                                            <span class="line-row"/>
                                            <span class="line-row"/>
                                            <span class="line-row"/>
                                            <span class="line-row"/>
                                        </t>
                                    </td>
                                </tr>

                                <!-- 3. Collect Hospital Updates -->
                                <tr>
                                    <td class="check-column">
                                        <t t-if="o.update_notes">
                                            <i class="fa fa-check-square-o"/>
                                        </t>
                                        <t t-else="">
                                            <i class="fa fa-square-o"/>
                                        </t>
                                    </td>
                                    <td><strong>Collect hospital updates (discounts, free services, announcements)</strong></td>
                                    <td class="notes-cell">
                                        <t t-if="o.update_notes">
                                            <span t-field="o.update_notes"/>
                                        </t>
                                        <t t-else="">
                                            <span class="line-row"/>
                                            <span class="line-row"/>
                                            <span class="line-row"/>
                                            <span class="line-row"/>
                                            <span class="line-row"/>
                                        </t>
                                    </td>
                                </tr>

                                <!-- 4. Record Complaints -->
                                <tr>
                                    <td class="check-column">
                                        <t t-if="o.complaint_notes">
                                            <i class="fa fa-check-square-o"/>
                                        </t>
                                        <t t-else="">
                                            <i class="fa fa-square-o"/>
                                        </t>
                                    </td>
                                    <td><strong>Record hospital complaints about Baano services</strong></td>
                                    <td class="notes-cell">
                                        <t t-if="o.complaint_notes">
                                            <span t-field="o.complaint_notes"/>
                                        </t>
                                        <t t-else="">
                                            <span class="line-row"/>
                                            <span class="line-row"/>
                                            <span class="line-row"/>
                                            <span class="line-row"/>
                                            <span class="line-row"/>
                                        </t>
                                    </td>
                                </tr>

                                <!-- 5. Collaboration Challenges -->
                                <tr>
                                    <td class="check-column">
                                        <t t-if="o.challenge_notes">
                                            <i class="fa fa-check-square-o"/>
                                        </t>
                                        <t t-else="">
                                            <i class="fa fa-square-o"/>
                                        </t>
                                    </td>
                                    <td><strong>Identify collaboration challenges with hospitals</strong></td>
                                    <td class="notes-cell">
                                        <t t-if="o.challenge_notes">
                                            <span t-field="o.challenge_notes"/>
                                        </t>
                                        <t t-else="">
                                            <span class="line-row"/>
                                            <span class="line-row"/>
                                            <span class="line-row"/>
                                            <span class="line-row"/>
                                            <span class="line-row"/>
                                        </t>
                                    </td>
                                </tr>
                            </tbody>
                        </table>
                    </div>
                </t>
            </t>
        </t>
    </template>
</odoo>
