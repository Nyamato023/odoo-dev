<?xml version="1.0" encoding="utf-8"?>
<!-- timetable_module/views/timetable_task_views.xml -->
<odoo>
    <!-- Form View for Timetable Task -->
    <record id="timetable_task_form_view" model="ir.ui.view">
        <field name="name">timetable.task.form</field>
        <field name="model">timetable.task</field>
        <field name="arch" type="xml">
            <form string="Timetable Task">
                <sheet>
                    <group>
                        <field name="name"/>
                        <field name="user_id"/>
                        <field name="start_datetime"/>
                        <field name="duration"/>
                        <field name="end_datetime" readonly="1"/>
                        <field name="color"/>
                        <field name="project_task_id" invisible="not is_link_projects"/>
                        <field name="is_link_projects" invisible="1"/>
                    </group>
                    <notebook>
                        <page string="Description">
                            <field name="description"/>
                        </page>
                        <page string="Subtasks">
                            <field name="subtask_ids">
                                <tree editable="bottom">
                                    <field name="name"/>
                                    <field name="description"/>
                                </tree>
                            </field>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Tree View for Timetable Task -->
    <record id="timetable_task_tree_view" model="ir.ui.view">
        <field name="name">timetable.task.tree</field>
        <field name="model">timetable.task</field>
        <field name="arch" type="xml">
            <tree string="Timetable Tasks">
                <field name="name"/>
                <field name="user_id"/>
                <field name="start_datetime"/>
                <field name="duration"/>
                <field name="end_datetime"/>
                <field name="color"/>
                <field name="project_task_id"/>
            </tree>
        </field>
    </record>

    <!-- Kanban View for Timetable Task -->
    <record id="timetable_task_kanban_view" model="ir.ui.view">
        <field name="name">timetable.task.kanban</field>
        <field name="model">timetable.task</field>
        <field name="arch" type="xml">
            <kanban default_group_by="user_id">
                <field name="name"/>
                <field name="user_id"/>
                <field name="start_datetime"/>
                <field name="duration"/>
                <field name="color"/>
                <field name="project_task_id"/>
                <templates>
                    <t t-name="card">
                        <div class="oe_kanban_details">
                            <strong><field name="name"/></strong>
                            <div>Assigned to: <field name="user_id"/></div>
                            <div>Start: <field name="start_datetime"/></div>
                            <div>Duration: <field name="duration"/> hours</div>
                            <div>Color: <field name="color"/></div>
                            <div t-if="record.is_link_projects.raw_value">Project Task: <field name="project_task_id"/></div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>


    <!-- Action for Timetable Tasks -->
    <record id="timetable_task_action" model="ir.actions.act_window">
        <field name="name">Timetable Tasks</field>
        <field name="res_model">timetable.task</field>
        <field name="view_mode">calendar,tree,form,kanban</field>
    </record>

    <!-- Menu Item -->
    <menuitem id="timetable_menu" name="Timetable" action="timetable_task_action"/>
</odoo>
